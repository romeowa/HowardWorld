rules_version = '2';

// howardworld 프로젝트의 Firestore 규칙 (공유 인프라).
// 여러 앱이 같은 Firestore를 쓰므로 규칙은 이 파일 하나로만 관리한다.
//   배포: cd firestore && firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // --- trip-planner: 여행 일정 공유 (howard-trips.web.app) ---
    // 링크(문서 ID)를 아는 사람만 접근. 전체 목록 조회(list)는 차단.
    match /trips/{tripId} {
      allow get, write: if true;
      allow list: if false;
      match /items/{itemId} {
        allow read, write: if true; // tripId(비밀 링크)를 아는 사람만 도달
      }
    }

    // --- 공용 사용 로그 ---
    // 누구나 남길 수 있으나 조회는 관리자 구글 계정으로 로그인했을 때만(웹 /admin).
    match /events/{eventId} {
      allow create: if true;
      allow read, list: if request.auth != null
        && request.auth.token.email == 'romeowa@gmail.com';
      allow update, delete: if false;
    }
  }
}
