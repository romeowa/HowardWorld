rules_version = '2';

// 개인 프로젝트 v1: 인증 없이 열어둠.
// 데이터가 민감해지면 Firebase Auth(구글 로그인) 붙이고 request.auth.uid 체크로 잠글 것.
//
// ⚠️ howardworld 프로젝트의 Firestore 규칙은 이 파일 하나로 관리한다.
//    (flight-watch + trip-planner 등 여러 프로젝트가 같은 Firestore를 공유)
//    규칙 변경은 반드시 이 파일에서 하고 `firebase deploy --only firestore:rules`로 배포할 것.
service cloud.firestore {
  match /databases/{database}/documents {
    // --- trip-planner: 여행 일정 공유 (howard-trips.web.app) ---
    // 링크(문서 ID)를 아는 사람만 접근. 전체 목록 조회(list)는 차단해 다른 사람 여행이 노출되지 않게 함.
    match /trips/{tripId} {
      allow get, write: if true;
      allow list: if false;
      match /items/{itemId} {
        allow read, write: if true; // tripId(비밀 링크)를 아는 사람만 여기 도달
      }
    }

    // --- flight-watch ---
    match /watches/{watchId} {
      allow read, write: if true;
      match /history/{entryId} {
        allow read: if true;
        allow write: if false; // history는 서버(Functions)만 기록
      }
    }
    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }
    match /control/{docId} {
      allow read: if true;
      allow write: if docId == 'checkNow'; // status는 데몬(Admin SDK)만 기록
    }
    match /notifications/{docId} {
      allow read: if true;
      allow write: if false; // 데몬(Admin SDK)만 기록
    }

    // --- 공용 사용 로그 ---
    // 누구나 남길 수 있으나 조회는 관리자 구글 계정으로 로그인했을 때만(웹 admin).
    match /events/{eventId} {
      allow create: if true;
      allow read, list: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'romeowa@gmail.com';
      allow update, delete: if false;
    }
  }
}
