<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.howard.flight-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/howard/HowardWorld/flight-watch/crawler/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/howard/HowardWorld/flight-watch/crawler</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/howard/Library/Logs/flight-watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/howard/Library/Logs/flight-watch.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHECK_INTERVAL_MIN</key>
    <string>60</string>
  </dict>
</dict>
</plist>
